# Deployed Google Apps Script Web App URL (ends in /exec).
# See docs/apps-script-setup.md for how to get this.
VITE_API_BASE_URL=

# Google OAuth client ID for Sign In With Google.
# See docs/google-signin-setup.md for how to get this.
VITE_GOOGLE_CLIENT_ID=

# Shared secret the Apps Script backend checks on every request. Generate
# one yourself (e.g. `openssl rand -hex 24`), set it as the API_KEY Script
# Property on the Apps Script project, and put the same value here.
# See docs/apps-script-setup.md.
VITE_API_KEY=
