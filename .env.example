# Supabase project URL and anon (public) key: Supabase dashboard → Project
# Settings → API. The anon key is safe to ship in the frontend; row-level
# security in supabase/migrations decides what each signed-in user can see.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google OAuth client ID for Sign In With Google. The same ID must be listed
# under Supabase → Authentication → Providers → Google → Client IDs.
# See docs/supabase-vercel-setup.md.
VITE_GOOGLE_CLIENT_ID=
