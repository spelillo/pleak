# Optional: the app defaults to Pleak's own Supabase project (see
# src/lib/supabase.ts). Set these only to point at a different project.
# The publishable/anon key is safe to ship in the frontend; row-level
# security in supabase/migrations decides what each signed-in user can see.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: defaults to Pleak's own Google OAuth client ID. The ID in use must be listed
# under Supabase → Authentication → Providers → Google → Client IDs.
# See docs/supabase-vercel-setup.md.
VITE_GOOGLE_CLIENT_ID=
