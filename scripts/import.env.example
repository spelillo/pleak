# Copy to .env.import (gitignored) for scripts/import-from-sheets.mjs.

# The old Apps Script Web App URL and API key (today's VITE_API_BASE_URL and
# VITE_API_KEY values / GitHub secrets).
SHEETS_API_URL=
SHEETS_API_KEY=

# Supabase dashboard → Project Settings → API. The service_role key bypasses
# row-level security: keep it on your machine only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
